<!DOCTYPE html>
<html lang="id" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portofolio Saya</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkBg: '#090d16',
                        cardBg: '#111726',
                        accent: '#6366f1',
                        accentGlow: '#818cf8',
                    }
                }
            }
        }
    </script>
    <!-- Font Inter & Lucide Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .glass {
            background: rgba(17, 23, 38, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
    </style>
</head>
<body class="bg-darkBg text-slate-200 antialiased selection:bg-indigo-500 selection:text-white">

    <!-- Header / Navbar -->
    <header class="fixed top-0 left-0 right-0 z-50 px-6 py-4">
        <nav class="max-w-5xl mx-auto glass rounded-2xl px-6 py-3 flex items-center justify-between shadow-2xl">
            <a href="#" class="text-xl font-bold bg-gradient-to-r from-indigo-400 to-cyan-400 bg-clip-text text-transparent">
                Portfolio<span class="text-indigo-500">.</span>
            </a>
            
            <div class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-400">
                <a href="#about" class="hover:text-indigo-400 transition-colors">Tentang</a>
                <a href="#skills" class="hover:text-indigo-400 transition-colors">Keahlian</a>
                <a href="#projects" class="hover:text-indigo-400 transition-colors">Proyek</a>
                <a href="#contact" class="hover:text-indigo-400 transition-colors">Kontak</a>
            </div>

            <a href="#contact" class="px-4 py-2 text-xs font-semibold rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white transition-all shadow-lg shadow-indigo-500/20">
                Hubungi Saya
            </a>
        </nav>
    </header>

    <!-- Hero Section -->
    <section class="min-h-screen flex items-center justify-center pt-24 pb-16 px-6 relative overflow-hidden">
        <!-- Ambient Background Light -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-indigo-600/20 rounded-full blur-[120px] pointer-events-none"></div>

        <div class="max-w-4xl mx-auto text-center space-y-8 relative z-10">
            <!-- Frame Upload Foto Profil Dinamis -->
            <div class="relative group w-36 h-36 mx-auto">
                <div class="absolute -inset-1 bg-gradient-to-r from-indigo-500 to-cyan-500 rounded-full blur opacity-70 group-hover:opacity-100 transition duration-500"></div>
                <div class="relative w-36 h-36 rounded-full overflow-hidden bg-slate-800 flex items-center justify-center border-2 border-slate-700/80">
                    <img id="avatarPreview" src="foto profil.jpg" alt="Foto Profil" class="w-full h-full object-cover">
                </div>
                <!-- Tombol Ganti Foto -->
                <label for="uploadFoto" class="absolute bottom-0 right-0 bg-indigo-600 hover:bg-indigo-500 text-white p-2.5 rounded-full cursor-pointer shadow-lg transition-transform hover:scale-110">
                    <i data-lucide="camera" class="w-4 h-4"></i>
                    <input type="file" id="uploadFoto" accept="image/*" class="hidden" onchange="previewImage(event)">
                </label>
            </div>

            <div class="space-y-3">
                <span class="inline-block px-3 py-1 text-xs font-medium bg-indigo-500/10 text-indigo-400 rounded-full border border-indigo-500/20">
                    Halo, Selamat Datang 👋
                </span>
                <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight">
                    Membangun Pengalaman <br>
                    <span class="bg-gradient-to-r from-indigo-400 via-sky-400 to-emerald-400 bg-clip-text text-transparent">Digital yang Memukau</span>
                </h1>
                <p class="text-slate-400 max-w-xl mx-auto text-base md:text-lg leading-relaxed">
                    Siswa / Developer yang berfokus menciptakan tampilan web bersih, responsif, dan fungsional.
                </p>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-center gap-4">
                <a href="#projects" class="px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm transition-all shadow-lg shadow-indigo-600/30">
                    Lihat Karya
                </a>
                <a href="#contact" class="px-6 py-3 rounded-xl glass hover:bg-slate-800 text-slate-300 font-medium text-sm transition-all">
                    Mari Berdiskusi
                </a>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="py-20 px-6 border-t border-slate-800/60">
        <div class="max-w-4xl mx-auto space-y-8">
            <div class="text-center space-y-2">
                <h2 class="text-2xl md:text-3xl font-bold text-white">Tentang Saya</h2>
                <div class="w-12 h-1 bg-indigo-500 mx-auto rounded-full"></div>
            </div>
            
            <div class="glass p-8 rounded-2xl text-slate-300 leading-relaxed text-center md:text-left space-y-4">
                <p>
                    Saya seorang pengembang independen dan pelajar yang antusias dalam dunia teknologi. Saya suka menyederhanakan masalah kompleks menjadi antarmuka yang indah dan mudah digunakan.
                </p>
                <p class="text-slate-400 text-sm">
                    Selalu terbuka untuk mempelajari teknologi baru, berkolaborasi dalam proyek seru, dan meningkatkan keterampilan coding setiap harinya.
                </p>
            </div>
        </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="py-20 px-6 border-t border-slate-800/60">
        <div class="max-w-4xl mx-auto space-y-10">
            <div class="text-center space-y-2">
                <h2 class="text-2xl md:text-3xl font-bold text-white">Keahlian & Alat</h2>
                <div class="w-12 h-1 bg-indigo-500 mx-auto rounded-full"></div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="glass p-5 rounded-2xl flex items-center space-x-4 hover:border-indigo-500/50 transition-all group">
                    <div class="p-3 bg-indigo-500/10 rounded-xl text-indigo-400 group-hover:bg-indigo-500 group-hover:text-white transition-all">
                        <i data-lucide="code-2" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-white text-sm">HTML & CSS</h3>
                        <p class="text-xs text-slate-400">Frontend</p>
                    </div>
                </div>

                <div class="glass p-5 rounded-2xl flex items-center space-x-4 hover:border-indigo-500/50 transition-all group">
                    <div class="p-3 bg-indigo-500/10 rounded-xl text-indigo-400 group-hover:bg-indigo-500 group-hover:text-white transition-all">
                        <i data-lucide="file-json" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-white text-sm">JavaScript</h3>
                        <p class="text-xs text-slate-400">Interaktivitas</p>
                    </div>
                </div>

                <div class="glass p-5 rounded-2xl flex items-center space-x-4 hover:border-indigo-500/50 transition-all group">
                    <div class="p-3 bg-indigo-500/10 rounded-xl text-indigo-400 group-hover:bg-indigo-500 group-hover:text-white transition-all">
                        <i data-lucide="palette" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-white text-sm">Tailwind CSS</h3>
                        <p class="text-xs text-slate-400">Styling</p>
                    </div>
                </div>

                <div class="glass p-5 rounded-2xl flex items-center space-x-4 hover:border-indigo-500/50 transition-all group">
                    <div class="p-3 bg-indigo-500/10 rounded-xl text-indigo-400 group-hover:bg-indigo-500 group-hover:text-white transition-all">
                        <i data-lucide="git-branch" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-white text-sm">Git & GitHub</h3>
                        <p class="text-xs text-slate-400">Version Control</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="py-20 px-6 border-t border-slate-800/60">
        <div class="max-w-4xl mx-auto space-y-10">
            <div class="text-center space-y-2">
                <h2 class="text-2xl md:text-3xl font-bold text-white">Proyek Unggulan</h2>
                <div class="w-12 h-1 bg-indigo-500 mx-auto rounded-full"></div>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
                <!-- Card 1 -->
                <div class="glass rounded-2xl overflow-hidden hover:border-indigo-500/50 transition-all group">
                    <div class="h-48 bg-slate-800 relative overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=600&q=80" alt="Project" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                    </div>
                    <div class="p-6 space-y-3">
                        <h3 class="font-bold text-white text-lg">Aplikasi Web Portofolio</h3>
                        <p class="text-xs text-slate-400 leading-relaxed">Design website portofolio interaktif dan responsif dengan fitur upload foto profil langsung.</p>
                        <div class="flex items-center space-x-2 pt-2">
                            <span class="text-[10px] bg-indigo-500/10 text-indigo-400 px-2.5 py-1 rounded-md border border-indigo-500/20">Tailwind</span>
                            <span class="text-[10px] bg-indigo-500/10 text-indigo-400 px-2.5 py-1 rounded-md border border-indigo-500/20">JavaScript</span>
                        </div>
                    </div>
                </div>

                <!-- Card 2 -->
                <div class="glass rounded-2xl overflow-hidden hover:border-indigo-500/50 transition-all group">
                    <div class="h-48 bg-slate-800 relative overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?auto=format&fit=crop&w=600&q=80" alt="Project" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                    </div>
                    <div class="p-6 space-y-3">
                        <h3 class="font-bold text-white text-lg">Sistem Kasir & Data Sales</h3>
                        <p class="text-xs text-slate-400 leading-relaxed">Dashboard manajemen data transaksi sederhana dengan analitik visual yang efisien.</p>
                        <div class="flex items-center space-x-2 pt-2">
                            <span class="text-[10px] bg-indigo-500/10 text-indigo-400 px-2.5 py-1 rounded-md border border-indigo-500/20">Python</span>
                            <span class="text-[10px] bg-indigo-500/10 text-indigo-400 px-2.5 py-1 rounded-md border border-indigo-500/20">MySQL</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-20 px-6 border-t border-slate-800/60">
        <div class="max-w-2xl mx-auto space-y-8 text-center">
            <div class="space-y-2">
                <h2 class="text-2xl md:text-3xl font-bold text-white">Hubungi Saya</h2>
                <p class="text-sm text-slate-400">Punya pertanyaan atau ingin bekerja sama? Kirimkan pesan di bawah ini!</p>
            </div>

            <form onsubmit="handleSubmit(event)" class="glass p-8 rounded-2xl space-y-4 text-left">
                <div>
                    <label class="block text-xs text-slate-400 mb-1">Nama Lengkap</label>
                    <input type="text" required placeholder="Nama Anda" class="w-full bg-slate-900/60 border border-slate-700/60 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-indigo-500 transition-colors">
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1">Email</label>
                    <input type="email" required placeholder="email@contoh.com" class="w-full bg-slate-900/60 border border-slate-700/60 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-indigo-500 transition-colors">
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1">Pesan</label>
                    <textarea rows="4" required placeholder="Tuliskan pesan Anda..." class="w-full bg-slate-900/60 border border-slate-700/60 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-indigo-500 transition-colors"></textarea>
                </div>
                <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl text-sm transition-all shadow-lg shadow-indigo-600/30">
                    Kirim Pesan
                </button>
            </form>
        </div>
    </section>

    <!-- Footer -->
    <footer class="py-8 text-center text-xs text-slate-500 border-t border-slate-800/60">
        <p>&copy; 2026 Portofolio Saya. Dibuat dengan Tailwind CSS & Vanilla JS.</p>
    </footer>

    <!-- JavaScript Script -->
    <script>
        // Inisialisasi Ikon Lucide
        lucide.createIcons();

        // Fitur Ganti Foto Profil Realtime
        function previewImage(event) {
            const reader = new FileReader();
            reader.onload = function() {
                const output = document.getElementById('avatarPreview');
                output.src = reader.result;
            }
            if (event.target.files[0]) {
                reader.readAsDataURL(event.target.files[0]);
            }
        }

        // Handle Submit Form Kontak
        function handleSubmit(event) {
            event.preventDefault();
            alert('Pesan Anda telah berhasil dikirim! Terima kasih.');
            event.target.reset();
        }
    </script>
</body>
</html>
